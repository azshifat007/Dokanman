# Copy to `.env.local` for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for deployments.
#
# Neon Postgres connection strings (Project → Connect in the Neon console).
# DATABASE_URL is the pooled connection used by the app at runtime.
# DATABASE_URL_UNPOOLED is used by `npm run db:migrate`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dokanman?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/dokanman?sslmode=require"

# Signs the 30-day session cookie. Required in production; must be at least
# 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
